PORT=4000

# Quota Budget Manager - External API Keys
# Primary Gold: MetalCharts (api.metalcharts.org)
METALCHARTS_API_KEY=your_metalcharts_api_key_here

# Secondary Gold Cross-Check (Max 1 call/day): MetalpriceAPI
GOLD_API_KEY=your_gold_api_key_here
METALPRICE_API_KEY=your_metalprice_api_key_here

# US Equities (Capped at 30 calls/min Token Bucket): Finnhub
FINNHUB_API_KEY=your_finnhub_api_key_here

# Application budgets. Provider response headers override the MetalCharts
# remaining count when available.
METALCHARTS_MONTHLY_LIMIT=1000
METALPRICE_MONTHLY_LIMIT=100
METALPRICE_MAX_DAILY_CALLS=1
FINNHUB_CALLS_PER_MINUTE=60

# Cache TTL Configurations (Seconds)
GOLD_CACHE_TTL=3600
STOCK_CACHE_TTL=300
GOLD_SCHEDULE_MIN_MINUTES=60
